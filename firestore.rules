rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Submission deadline — keep this in sync with DEADLINE in index.html.
    // 27 Oct 2026, 05:59 Israel Standard Time (UTC+2) = 03:59 UTC.
    function afterDeadline() {
      return request.time >
             timestamp.date(2026, 10, 27) + duration.time(3, 59, 0, 0);
    }

    function isAdmin() {
      return request.auth.uid == 'Hrunf67LwlVfZ7xNbEqwn0SEXFt2';
    }

    function isApproved() {
      return isAdmin()
             || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.approved == true;
    }

    // A player may WRITE their OWN prediction only until the deadline, and only
    // once the admin has approved their account (enforced here, not just in the
    // UI, so it can't be bypassed via the console or raw API).
    // Reading ANYONE ELSE's prediction (a single get, or listing the whole
    // collection) is blocked until the deadline passes — so nobody can peek at
    // others' guesses while submissions are still open.
    match /predictions/{uid} {
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && !afterDeadline()
                   && isApproved();
      allow read:  if request.auth != null
                   && (request.auth.uid == uid || afterDeadline());
    }

    // Per-account approval gate. New registrations always start unapproved —
    // nobody can approve themselves; only the admin account may flip this,
    // and only the approved flag (identity fields are pinned on update).
    //
    // A user may ALSO flip their own hasSubmitted flag to true (set the moment
    // they save a prediction) so the "כל הניחושים" tab can show who has
    // already submitted before the deadline, without exposing what anyone
    // guessed. They can't touch approved/uid/username, and can't use it to
    // unflag themselves or anyone else.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.uid == uid
                    && request.resource.data.approved == false;
      allow update: if request.auth != null
                    && request.resource.data.uid == resource.data.uid
                    && request.resource.data.username == resource.data.username
                    && (
                         isAdmin()
                         || (request.auth.uid == uid
                             && request.resource.data.approved == resource.data.approved
                             && request.resource.data.hasSubmitted == true)
                       );
      allow delete: if false;
    }

    // The real, admin-entered election results (meta/results).
    // Anyone signed in can read it; only the admin account may write it.
    match /meta/{docId} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null
                   && isAdmin();
    }

    // Username -> uid registry, so a side bet can look up "dana123" and
    // invite the right account. Doc id is the lowercase username. A user may
    // only ever claim/own their OWN mapping — never overwrite someone else's.
    match /usernames/{username} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == request.resource.data.uid
                   && (resource == null || resource.data.uid == request.auth.uid);
    }

    // Side bets: a custom over/under challenge between two registered users.
    // Visible to everyone signed in (a public feed); only the two people
    // involved can ever change its status, and only along a pending ->
    // accepted/declined/cancelled path — no other field may change on update.
    match /sidebets/{betId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.creatorUid
                    && request.resource.data.creatorUid != request.resource.data.inviteeUid
                    && request.resource.data.status == 'pending'
                    && isApproved();
      allow update: if request.auth != null
                    && request.resource.data.creatorUid == resource.data.creatorUid
                    && request.resource.data.inviteeUid == resource.data.inviteeUid
                    && request.resource.data.partyId == resource.data.partyId
                    && request.resource.data.line == resource.data.line
                    && request.resource.data.creatorSide == resource.data.creatorSide
                    && (
                         (request.auth.uid == resource.data.inviteeUid
                          && resource.data.status == 'pending'
                          && request.resource.data.status in ['accepted', 'declined'])
                         ||
                         (request.auth.uid == resource.data.creatorUid
                          && resource.data.status == 'pending'
                          && request.resource.data.status == 'cancelled')
                       );
      allow delete: if false;
    }
  }
}
